---
import Sidebar from './Sidebar.astro';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<div data-menu-modal>
<button
  type="button"
  class="mobile-menu-toggle"
  aria-expanded="false"
  aria-controls="mobile-nav-overlay"
  data-menu-toggle
>
  <span class="mobile-menu-toggle__icon" aria-hidden="true"></span>
  <span class="sr-only" data-menu-toggle-label>Open menu</span>
</button>

<div class="mobile-overlay" id="mobile-nav-overlay" hidden data-menu-drawer>
  <div class="mobile-overlay__scrim" data-menu-close tabindex="-1" aria-hidden="true"></div>
  <div class="mobile-overlay__nav">
    <Sidebar pathname={pathname} id="mobile-site-nav" />
  </div>
</div>
</div>

<style>
  .mobile-menu-toggle {
    display: none;
    position: fixed;
    left: var(--spacing-3);
    bottom: var(--spacing-3);
    z-index: 120;
    align-items: center;
    justify-content: center;
    width: var(--icon-mobile-menu-button);
    height: var(--icon-mobile-menu-button);
    padding: 0;
    border: 0;
    border-radius: var(--spacing-1);
    background: var(--nav-pill-resting);
    color: var(--text-primary);
    cursor: pointer;
    filter: none;
    transition: background-color 120ms ease;
  }

  .mobile-menu-toggle:hover {
    background: var(--nav-pill-hovered);
  }

  .mobile-menu-toggle__icon,
  .mobile-menu-toggle__icon::before,
  .mobile-menu-toggle__icon::after {
    display: block;
    width: var(--spacing-4);
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform 180ms ease,
      opacity 180ms ease,
      top 180ms ease;
  }

  .mobile-menu-toggle__icon {
    position: relative;
  }

  .mobile-menu-toggle__icon::before,
  .mobile-menu-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .mobile-menu-toggle__icon::before {
    top: calc(var(--spacing-2) * -0.75);
  }

  .mobile-menu-toggle__icon::after {
    top: calc(var(--spacing-2) * 0.75);
  }

  .mobile-overlay[hidden] {
    display: none;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  .mobile-overlay:not([hidden]) {
    display: block;
    pointer-events: auto;
  }

  /* Full-viewport tint surface over blurred content */
  .mobile-overlay__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--surface-default) 10%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .mobile-overlay:not([hidden]) .mobile-overlay__scrim {
    opacity: 1;
  }

  /* Transparent nav stack — pills only, no panel surface */
  .mobile-overlay__nav {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: fit-content;
    max-width: min(var(--viewport-mobile-drawer-width), var(--viewport-mobile-drawer-max), 88vw);
    height: auto;
    max-height: 100%;
    overflow: auto;
    background: transparent;
    pointer-events: auto;
    filter: none;
    transform: translateX(-0.5rem);
    opacity: 0;
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }

  .mobile-overlay:not([hidden]) .mobile-overlay__nav {
    transform: translateX(0);
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Desktop sidebar — s (768px) and above */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-toggle,
    .mobile-menu-toggle__icon,
    .mobile-menu-toggle__icon::before,
    .mobile-menu-toggle__icon::after,
    .mobile-overlay__scrim,
    .mobile-overlay__nav {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu-toggle,
    .mobile-overlay {
      display: none !important;
    }
  }

  /* Mobile overlay nav — below s (768px) */
  @media (width < 768px) {
    :global(body[data-menu-open]) .mobile-menu-toggle__icon {
      background: transparent;
    }

    :global(body[data-menu-open]) .mobile-menu-toggle__icon::before {
      top: 0;
      transform: rotate(45deg);
    }

    :global(body[data-menu-open]) .mobile-menu-toggle__icon::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }
  }
</style>
