---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Can Aslan" description="An unfinished profile page for Can Aslan." noindex>
  <h1>About</h1>
  <p>
    I'm Can Aslan — a developer focused on building useful, well-crafted software.
    This site is a home for my work, writing, and contact info.
  </p>
  <p>
    Edit this page in <code>src/pages/about.astro</code> to add your background,
    skills, and what you're working on right now.
  </p>
</Layout>

<style>
  code {
    font-family: var(--font-family-mono);
    font-size: var(--size-mono-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-mono-regular);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--spacing-1);
    padding: 0.1em 0.35em;
  }
</style>
