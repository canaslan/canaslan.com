---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Link from '../components/Link.astro';
---

<Layout title="Colophon — Can Aslan" description="The design, typography, and technology behind Can Aslan’s website." viewportGrid>
  <article class="colophon-page editorial-page">
    <Breadcrumb items={[
      { label: 'Can Aslan', href: '/' },
      { label: 'Colophon', current: true },
    ]} />
    <h1>Colophon</h1>
    <div class="colophon-copy">
      <p>I designed and built this site as a home for my work, ideas, and independent design practice.</p>

      <section aria-labelledby="design-heading">
        <h2 id="design-heading">Design</h2>
        <p>Designed in Figma, with a shared system of colours, typography, spacing, and components. The site uses a warm neutral palette with orange accents across light and dark themes. Design tokens carry these decisions into the code.</p>
      </section>

      <section aria-labelledby="typography-heading">
        <h2 id="typography-heading">Typography</h2>
        <p><Link href="https://fonts.google.com/specimen/Inter" newTab>Inter</Link> for headings and body text. <Link href="https://www.jetbrains.com/lp/mono/" newTab>JetBrains Mono</Link> for navigation, labels, and tables. Both are served through Google Fonts.</p>
      </section>

      <section aria-labelledby="build-heading">
        <h2 id="build-heading">Build</h2>
        <p>Built with <Link href="https://astro.build/" newTab>Astro</Link>, HTML, and CSS, with JavaScript for interactions such as navigation and theme switching. Pages are generated as static HTML and deployed on Cloudflare Workers.</p>
      </section>

      <section aria-labelledby="accessibility-heading">
        <h2 id="accessibility-heading">Accessibility</h2>
        <p>The site meets WCAG 2.2 Level AA, with keyboard navigation, visible focus states, and support for reduced motion.</p>
      </section>

      <section aria-labelledby="privacy-heading">
        <h2 id="privacy-heading">Privacy</h2>
        <p>This site uses Umami Cloud to collect aggregate page-view and interaction data. Tracking is limited to this production domain, excludes search parameters and page fragments, respects supported Do Not Track preferences, and does not send names, email addresses, or message content.</p>
      </section>

      <footer><p>© 2026 Can Aslan. Last updated November 2026.</p></footer>
    </div>
  </article>
</Layout>

<style>
  h1 {
    margin: var(--page-heading-gap) 0 var(--spacing-4);
    font-size: var(--size-page-headline);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-page-headline);
    font-optical-sizing: none;
  }
  .colophon-copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    font-size: var(--size-body-m);
    line-height: var(--line-height-mono-regular);
  }
  .colophon-copy p { margin: 0; }
  .colophon-copy section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  h2 {
    margin: 0;
    font-size: var(--size-h2);
    line-height: calc(7 / 6);
    letter-spacing: var(--letter-spacing-page-headline);
  }
  @media (min-width: 1768px) {
    /* Keep the sample's 720px prose measure within the centered viewport grid. */
    .colophon-page { --editorial-width: 45rem; }
  }
</style>
