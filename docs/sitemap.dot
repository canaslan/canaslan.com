// Can Aslan — launch sitemap, updated 2026-11-05.
// Services overview and detail routes are deferred and excluded from this release.
// Import by dragging this file onto OmniGraffle's Dock icon.
// Solid lines: navigation hierarchy (not URL nesting).
// Dashed lines: inventory grouping; not navigation links.
// Labels explicitly identify external destinations and placeholder content.
digraph CanAslanSitemap {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=12, style="rounded", color="#555555", fontcolor="#222222", width=2.3];
  edge [color="#777777", arrowhead=none];

  home [label="Can Aslan / Home\n/", URL="https://canaslan.com/"];
  work [label="Work\n/work", URL="https://canaslan.com/work/"];
  principles [label="Principles\n/work/principles", URL="https://canaslan.com/work/principles/"];
  readme [label="Readme\n/readme", URL="https://canaslan.com/readme/"];
  blog [label="Blog [external]\ncanaslan.substack.com", style="rounded,dashed", URL="https://canaslan.substack.com/"];
  contact [label="Contact\n/contact", URL="https://canaslan.com/contact/"];
  colophon [label="Colophon [navigation footer]\n/colophon", URL="https://canaslan.com/colophon/"];

  unlisted [label="Routes outside main navigation\nInventory grouping", shape=box, style=dashed];
  about [label="About [noindex]\n/about\nStarter placeholder content", URL="https://canaslan.com/about/"];
  research [label="Research\n/research", URL="https://canaslan.com/research/"];

  home -> work;
  home -> readme;
  home -> blog;
  home -> contact;
  home -> colophon;
  work -> principles;

  home -> unlisted [style=dashed];
  unlisted -> about [style=dashed];
  unlisted -> research [style=dashed];
}
